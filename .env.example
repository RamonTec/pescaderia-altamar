NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (Server Actions / Admin API). NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Protege /api/cron/tasas (Bearer o ?secret=). Generar con: openssl rand -hex 32.
CRON_SECRET=
# Recordatorios de cobro por correo (09-cuentas-por-cobrar). Requiere un dominio
# verificado en Resend. Sin estas dos, el canal correo queda deshabilitado.
RESEND_API_KEY=
RECORDATORIO_EMAIL_FROM=
